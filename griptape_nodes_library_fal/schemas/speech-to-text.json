{
 "category": "speech-to-text",
 "models": {
  "fal-ai/cohere-transcribe": {
   "endpoint_id": "fal-ai/cohere-transcribe",
   "display_name": "Cohere Transcribe",
   "description": "Cohere Transcribe turns your business audio into accurate text, ready for search, analytics, and automation",
   "status_base": "fal-ai/cohere-transcribe",
   "input": {
    "properties": {
     "language": {
      "default": "en",
      "enum": [
       "en",
       "fr",
       "de",
       "it",
       "es",
       "pt",
       "el",
       "nl",
       "pl",
       "zh",
       "ja",
       "ko",
       "vi",
       "ar"
      ],
      "title": "Language",
      "type": "string",
      "description": "Language of the audio (ISO 639-1 code). Supported: en, fr, de, it, es, pt, el, nl, pl, zh, ja, ko, vi, ar."
     },
     "audio_url": {
      "title": "Audio Url",
      "type": "string",
      "description": "URL of the audio file to transcribe. Supported formats: mp3, mp4, mpeg, mpga, m4a, wav, webm, ogg, flac."
     },
     "max_new_tokens": {
      "default": 256,
      "title": "Max New Tokens",
      "type": "integer",
      "minimum": 1,
      "maximum": 1014,
      "description": "Maximum number of tokens to generate per audio chunk."
     },
     "punctuation": {
      "default": true,
      "title": "Punctuation",
      "type": "boolean",
      "description": "Whether to include punctuation and capitalization in the output."
     }
    },
    "title": "TranscribeInput",
    "type": "object",
    "x-fal-order-properties": [
     "audio_url",
     "language",
     "punctuation",
     "max_new_tokens"
    ],
    "required": [
     "audio_url"
    ]
   },
   "output": {
    "properties": {
     "timings": {
      "additionalProperties": {
       "type": "number"
      },
      "title": "Timings",
      "type": "object",
      "description": "Performance timing breakdown in seconds."
     },
     "text": {
      "title": "Text",
      "type": "string",
      "description": "Transcribed text from the audio file."
     }
    },
    "title": "TranscribeOutput",
    "type": "object",
    "x-fal-order-properties": [
     "text",
     "timings"
    ],
    "required": [
     "text"
    ]
   }
  },
  "fal-ai/elevenlabs/forced-alignment": {
   "endpoint_id": "fal-ai/elevenlabs/forced-alignment",
   "display_name": "Elevenlabs - Forced Alignment",
   "description": "Align the transcript and your audio recording using Elevenlab's forced alignment feature!",
   "status_base": "fal-ai/elevenlabs/forced-alignment",
   "input": {
    "properties": {
     "audio_url": {
      "title": "Audio Url",
      "description": "URL of the audio file to align. The file can be up to 3 GB and the audio can be up to 10 hours long.",
      "type": "string"
     },
     "text": {
      "maxLength": 675000,
      "minLength": 1,
      "description": "Transcript to align with the audio",
      "title": "Text",
      "type": "string"
     }
    },
    "title": "ForcedAlignmentRequest",
    "type": "object",
    "x-fal-order-properties": [
     "audio_url",
     "text"
    ],
    "required": [
     "audio_url",
     "text"
    ]
   },
   "output": {
    "properties": {
     "characters": {
      "title": "Characters",
      "description": "Character-level alignment details",
      "type": "array",
      "items": {
       "properties": {
        "start": {
         "title": "Start",
         "description": "Start time in seconds",
         "type": "number"
        },
        "end": {
         "title": "End",
         "description": "End time in seconds",
         "type": "number"
        },
        "text": {
         "title": "Text",
         "description": "The aligned character",
         "type": "string"
        }
       },
       "title": "ForcedAlignmentCharacter",
       "type": "object",
       "x-fal-order-properties": [
        "text",
        "start",
        "end"
       ],
       "required": [
        "text",
        "start",
        "end"
       ]
      }
     },
     "words": {
      "title": "Words",
      "description": "Word-level alignment details",
      "type": "array",
      "items": {
       "properties": {
        "start": {
         "title": "Start",
         "description": "Start time in seconds",
         "type": "number"
        },
        "loss": {
         "title": "Loss",
         "description": "Average alignment loss for the word",
         "type": "number"
        },
        "text": {
         "title": "Text",
         "description": "The aligned character",
         "type": "string"
        },
        "end": {
         "title": "End",
         "description": "End time in seconds",
         "type": "number"
        }
       },
       "title": "ForcedAlignmentWord",
       "type": "object",
       "x-fal-order-properties": [
        "text",
        "start",
        "end",
        "loss"
       ],
       "required": [
        "text",
        "start",
        "end",
        "loss"
       ]
      }
     },
     "loss": {
      "title": "Loss",
      "description": "Average alignment loss for the transcript",
      "type": "number"
     }
    },
    "title": "ForcedAlignmentOutput",
    "type": "object",
    "x-fal-order-properties": [
     "characters",
     "words",
     "loss"
    ],
    "required": [
     "characters",
     "words",
     "loss"
    ]
   }
  },
  "fal-ai/elevenlabs/speech-to-text": {
   "endpoint_id": "fal-ai/elevenlabs/speech-to-text",
   "display_name": "ElevenLabs Speech to Text",
   "description": "Generate text from speech using ElevenLabs advanced speech-to-text model.",
   "status_base": "fal-ai/elevenlabs/speech-to-text",
   "input": {
    "properties": {
     "audio_url": {
      "title": "Audio Url",
      "description": "URL of the audio file to transcribe",
      "type": "string"
     },
     "tag_audio_events": {
      "default": true,
      "title": "Tag Audio Events",
      "description": "Tag audio events like laughter, applause, etc.",
      "type": "boolean"
     },
     "language_code": {
      "title": "Language Code",
      "description": "Language code of the audio",
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "diarize": {
      "default": true,
      "title": "Diarize",
      "description": "Whether to annotate who is speaking",
      "type": "boolean"
     }
    },
    "title": "SpeechToTextRequest",
    "type": "object",
    "x-fal-order-properties": [
     "audio_url",
     "language_code",
     "tag_audio_events",
     "diarize"
    ],
    "required": [
     "audio_url"
    ]
   },
   "output": {
    "properties": {
     "language_probability": {
      "title": "Language Probability",
      "description": "Confidence in language detection",
      "type": "number"
     },
     "words": {
      "title": "Words",
      "description": "Word-level transcription details",
      "type": "array",
      "items": {
       "properties": {
        "start": {
         "title": "Start",
         "description": "Start time in seconds",
         "anyOf": [
          {
           "type": "number"
          },
          {
           "type": "null"
          }
         ]
        },
        "speaker_id": {
         "title": "Speaker Id",
         "description": "Speaker identifier if diarization was enabled",
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "type": {
         "title": "Type",
         "description": "Type of element (word, spacing, or audio_event)",
         "type": "string"
        },
        "end": {
         "title": "End",
         "description": "End time in seconds",
         "anyOf": [
          {
           "type": "number"
          },
          {
           "type": "null"
          }
         ]
        },
        "text": {
         "title": "Text",
         "description": "The transcribed word or audio event",
         "type": "string"
        }
       },
       "title": "TranscriptionWord",
       "type": "object",
       "x-fal-order-properties": [
        "text",
        "start",
        "end",
        "type",
        "speaker_id"
       ],
       "required": [
        "text",
        "type"
       ]
      }
     },
     "text": {
      "title": "Text",
      "description": "The full transcribed text",
      "type": "string"
     },
     "language_code": {
      "title": "Language Code",
      "description": "Detected or specified language code",
      "type": "string"
     }
    },
    "title": "TranscriptionOutput",
    "type": "object",
    "x-fal-order-properties": [
     "text",
     "language_code",
     "language_probability",
     "words"
    ],
    "required": [
     "text",
     "language_code",
     "language_probability",
     "words"
    ]
   }
  },
