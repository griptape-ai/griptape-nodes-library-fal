  "kotoba-technologies/kotoba-stt/v1/speech-to-text": {
   "endpoint_id": "kotoba-technologies/kotoba-stt/v1/speech-to-text",
   "display_name": "Kotoba Speech-to-Text",
   "description": "Accurate transcription of an audio clip in one request, with word timestamps, tuned for Japanese and East Asian languages.",
   "status_base": "kotoba-technologies/kotoba-stt/v1/speech-to-text",
   "input": {
    "properties": {
     "audio_url": {
      "description": "Speech to transcribe: an https:// URL on fal's CDN (Playground uploads and microphone recordings) or a base64 data: URI. Up to 2 minutes.",
      "title": "Audio Url",
      "type": "string"
     },
     "with_timestamps": {
      "description": "Return `words` with start and end times for each word.",
      "default": false,
      "title": "With Timestamps",
      "type": "boolean"
     },
     "language": {
      "enum": [
       "ja",
       "en",
       "ko",
       "zh",
       "es",
       "zh-hk",
       "zh-tw",
       "auto"
      ],
      "description": "Language spoken in the audio.",
      "title": "Language",
      "type": "string"
     },
     "kana": {
      "description": "Write personal and place names in katakana (Japanese).",
      "default": false,
      "title": "Kana",
      "type": "boolean"
     },
     "keywords": {
      "description": "Up to 1000 terms of at most 64 characters, such as names or product words, whose spelling the transcript should prefer.",
      "title": "Keywords",
      "anyOf": [
       {
        "items": {
         "maxLength": 64,
         "type": "string"
        },
        "maxItems": 1000,
        "type": "array"
       },
       {
        "type": "null"
       }
      ]
     },
     "diarization": {
      "description": "Attribute words to speakers (`speaker_id` on each word; models with speaker tokens only). Word times are null unless `with_timestamps` is also set.",
      "default": false,
      "title": "Diarization",
      "type": "boolean"
     }
    },
    "title": "SpeechToTextRequest",
    "x-fal-order-properties": [
     "audio_url",
     "language",
     "with_timestamps",
     "diarization",
     "keywords",
     "kana"
    ],
    "required": [
     "audio_url",
     "language"
    ],
    "additionalProperties": false,
    "type": "object"
   },
   "output": {
    "title": "SpeechToTextResponse",
    "required": [
     "language_code",
     "language_probability",
     "text",
     "words"
    ],
    "type": "object",
    "properties": {
     "language_probability": {
      "title": "Language Probability",
      "type": "number"
     },
     "language_code": {
      "title": "Language Code",
      "type": "string"
     },
     "words": {
      "items": {
       "title": "SpeechToTextWord",
       "required": [
        "text"
       ],
       "type": "object",
       "properties": {
        "speaker_id": {
         "title": "Speaker Id",
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "end": {
         "title": "End",
         "anyOf": [
          {
           "type": "number"
          },
          {
           "type": "null"
          }
         ]
        },
        "start": {
         "title": "Start",
         "anyOf": [
          {
           "type": "number"
          },
          {
           "type": "null"
          }
         ]
        },
        "type": {
         "enum": [
          "word",
          "spacing",
          "audio_event"
         ],
         "default": "word",
         "title": "Type",
         "type": "string"
        },
        "text": {
         "title": "Text",
         "type": "string"
        }
       }
      },
      "title": "Words",
      "type": "array"
     },
     "text": {
      "title": "Text",
      "type": "string"
     },
     "audio_duration_secs": {
      "title": "Audio Duration Secs",
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     }
    }
   }
  },
  "nvidia/nemotron-asr-multilingual/asr": {
   "endpoint_id": "nvidia/nemotron-asr-multilingual/asr",
   "display_name": "Nemotron Asr Multilingual",
   "description": "Nemotron-ASR-Streaming is a multi lingual, streaming Automatic Speech Recognition (ASR) engineered to deliver high-quality multi lingual transcription across both low-latency streaming and high-throughput batch workloads.",
   "status_base": "nvidia/nemotron-asr-multilingual/asr",
   "input": {
    "properties": {
     "audio_url": {
      "title": "Audio URL",
      "type": "string",
      "description": "URL of the audio file to transcribe."
     },
     "acceleration": {
      "default": "regular",
      "enum": [
       "none",
       "regular",
       "high",
       "full"
      ],
      "title": "Acceleration",
      "type": "string",
      "description": "Controls the speed/accuracy trade-off. 'none' = best accuracy (1.12s chunks), 'regular' = balanced (0.56s chunks), 'high' = faster (0.32s chunks), 'full' = fastest (0.08s chunks)."
     },
     "language": {
      "default": "auto",
      "enum": [
       "auto",
       "en-US",
       "en-GB",
       "es-US",
       "es-ES",
       "de-DE",
       "fr-FR",
       "fr-CA",
       "it-IT",
       "ar-AR",
       "ja-JP",
       "ko-KR",
       "pt-BR",
       "pt-PT",
       "ru-RU",
       "hi-IN",
       "zh-CN",
       "vi-VN",
       "he-IL",
       "nl-NL",
       "cs-CZ",
       "da-DK",
       "pl-PL",
       "nn-NO",
       "nb-NO",
       "sv-SE",
       "th-TH",
       "tr-TR",
       "bg-BG",
       "el-GR",
       "et-EE",
       "fi-FI",
       "hr-HR",
       "hu-HU",
       "lt-LT",
       "lv-LV",
       "ro-RO",
       "sk-SK",
       "uk-UA",
       "mt-MT",
       "sl-SI"
      ],
      "title": "Language",
      "type": "string",
      "description": "Target language for transcription (language-ID prompt). 'auto' lets the model detect the language."
     }
    },
    "title": "SpeechInput",
    "type": "object",
    "x-fal-order-properties": [
     "audio_url",
     "language",
     "acceleration"
    ],
    "required": [
     "audio_url"
    ]
   },
   "output": {
    "properties": {
     "partial": {
      "default": false,
      "title": "Partial Result",
      "type": "boolean",
      "description": "True if this is an intermediate result during streaming."
     },
     "output": {
      "title": "Transcribed Text",
      "type": "string",
      "description": "The transcribed text from the audio."
     }
    },
    "title": "SpeechOutput",
    "type": "object",
    "x-fal-order-properties": [
     "output",
     "partial"
    ],
    "required": [
     "output"
    ]
   }
  },
