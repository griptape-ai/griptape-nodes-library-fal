{
 "category": "image-to-text",
 "models": {
  "nvidia/nemotron-3-nano-omni/vision": {
   "endpoint_id": "nvidia/nemotron-3-nano-omni/vision",
   "display_name": "Nemotron 3 Nano Omni",
   "description": "Vision reasoning variant of NVIDIA's Nemotron 3 Nano Omni. 30B A3B hybrid Transformer-Mamba MoE - accepts an image plus a prompt and returns text.",
   "status_base": "nvidia/nemotron-3-nano-omni/vision",
   "input": {
    "properties": {
     "prompt": {
      "minLength": 1,
      "title": "Prompt",
      "description": "Text prompt to send to the model. English only.",
      "type": "string"
     },
     "image_url": {
      "title": "Image URL",
      "description": "URL of the image to reason about. RGB JPEG or PNG.",
      "type": "string"
     },
     "system_prompt": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "System Prompt",
      "description": "Optional system prompt to steer the model. Reasoning behavior is controlled by the separate `reasoning_mode` field."
     },
     "max_tokens": {
      "title": "Max Tokens",
      "maximum": 20000,
      "default": 1024,
      "description": "Maximum number of tokens to generate.",
      "type": "integer",
      "minimum": 1
     },
     "temperature": {
      "title": "Temperature",
      "maximum": 2,
      "default": 0.7,
      "description": "Sampling temperature. Lower is more deterministic.",
      "type": "number",
      "minimum": 0
     },
     "enable_safety_checker": {
      "default": true,
      "description": "Whether to enable the safety checker.",
      "type": "boolean",
      "title": "Enable Safety Checker"
     },
     "top_p": {
      "title": "Top P",
      "maximum": 1,
      "default": 0.95,
      "description": "Nucleus sampling probability mass.",
      "type": "number",
      "minimum": 0
     },
     "reasoning_mode": {
      "title": "Reasoning Mode",
      "default": "no_think",
      "description": "Whether the model should emit an explicit reasoning trace. `no_think` returns a direct answer; `think` returns chain-of-thought followed by the final answer.",
      "enum": [
       "think",
       "no_think"
      ],
      "type": "string"
     }
    },
    "required": [
     "prompt",
     "image_url"
    ],
    "title": "VisionInput",
    "type": "object",
    "x-fal-order-properties": [
     "prompt",
     "system_prompt",
     "reasoning_mode",
     "max_tokens",
     "temperature",
     "top_p",
     "enable_safety_checker",
     "image_url"
    ]
   },
   "output": {
    "properties": {
     "finish_reason": {
      "title": "Finish Reason",
      "default": "stop",
      "description": "Reason generation stopped.",
      "type": "string"
     },
     "usage": {
      "properties": {
       "output_tokens": {
        "title": "Output Tokens",
        "description": "Number of output tokens generated.",
        "type": "integer"
       },
       "input_tokens": {
        "title": "Input Tokens",
        "description": "Number of input tokens processed.",
        "type": "integer"
       }
      },
      "required": [
       "input_tokens",
       "output_tokens"
      ],
      "title": "UsageInfo",
      "type": "object",
      "x-fal-order-properties": [
       "input_tokens",
       "output_tokens"
      ]
     },
     "output": {
      "title": "Output",
      "description": "Generated text response.",
      "type": "string"
     }
    },
    "required": [
     "output",
     "usage"
    ],
    "title": "BaseOutput",
    "type": "object",
    "x-fal-order-properties": [
     "output",
     "finish_reason",
     "usage"
    ]
   }
  },
  "nvidia/nemotron-3-5-super/vision": {
   "endpoint_id": "nvidia/nemotron-3-5-super/vision",
   "display_name": "NVIDIA Nemotron 3.5 Super Vision",
   "description": "Ask NVIDIA Nemotron 3.5 Super questions about an image: describe scenes, read text and charts, and reason over what it sees.",
   "status_base": "nvidia/nemotron-3-5-super/vision",
   "input": {
    "required": [
     "prompt",
     "image_url"
    ],
    "properties": {
     "image_url": {
      "title": "Image URL",
      "type": "string",
      "description": "URL of the image to reason about. RGB JPEG or PNG."
     },
     "temperature": {
      "description": "Sampling temperature. NVIDIA recommends 1.0 for all tasks.",
      "title": "Temperature",
      "type": "number",
      "maximum": 2,
      "minimum": 0,
      "default": 1
     },
     "prompt": {
      "title": "Prompt",
      "type": "string",
      "description": "Text prompt to send to the model.",
      "minLength": 1
     },
     "enable_safety_checker": {
      "title": "Enable Safety Checker",
      "type": "boolean",
      "description": "Whether to enable the safety checker.",
      "default": true
     },
     "top_p": {
      "maximum": 1,
      "title": "Top P",
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Nucleus sampling probability mass.",
      "default": 0.95
     },
     "reasoning_mode": {
      "enum": [
       "think",
       "no_think"
      ],
      "title": "Reasoning Mode",
      "type": "string",
      "description": "`think` emits an explicit reasoning trace before the final answer; `no_think` returns a direct answer.",
      "default": "no_think"
     },
     "max_tokens": {
      "description": "Maximum number of tokens to generate.",
      "title": "Max Tokens",
      "type": "integer",
      "maximum": 32000,
      "minimum": 1,
      "default": 1024
     },
     "system_prompt": {
      "title": "System Prompt",
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Optional system prompt to steer the model."
     }
    },
    "x-fal-order-properties": [
     "prompt",
     "system_prompt",
     "reasoning_mode",
     "max_tokens",
     "temperature",
     "top_p",
     "enable_safety_checker",
     "image_url"
    ],
    "title": "VisionInput",
    "type": "object"
   },
   "output": {
    "required": [
     "output",
     "usage"
    ],
    "properties": {
     "usage": {
      "required": [
       "input_tokens",
       "output_tokens"
      ],
      "properties": {
       "input_tokens": {
        "title": "Input Tokens",
        "type": "integer",
        "description": "Number of input tokens processed."
       },
       "output_tokens": {
        "title": "Output Tokens",
        "type": "integer",
        "description": "Number of output tokens generated."
       }
      },
      "x-fal-order-properties": [
       "input_tokens",
       "output_tokens"
      ],
      "title": "UsageInfo",
      "type": "object"
     },
     "finish_reason": {
      "title": "Finish Reason",
      "type": "string",
      "description": "Reason generation stopped.",
      "default": "stop"
     },
     "reasoning": {
      "title": "Reasoning",
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Reasoning trace, returned only in `think` mode."
     },
     "output": {
      "title": "Output",
      "type": "string",
      "description": "Generated text response."
     }
    },
    "x-fal-order-properties": [
     "output",
     "reasoning",
     "finish_reason",
     "usage"
    ],
    "title": "ChatOutput",
    "type": "object"
   }
  }
 }
}
